<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.situ.elder.mapper.RoomMapper">
    <resultMap id="RoomVOMap" type="com.situ.elder.pojo.vo.RoomVO">
        <id column="id" property="id" />
        <result column="building_id" property="buildingId" />
        <result column="building_name" property="buildingName" />
        <result column="room_no" property="roomNo" />
        <result column="floor" property="floor" />
        <result column="room_type" property="roomType" />
        <result column="bed_count" property="bedCount" />
        <result column="status" property="status" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
        <result column="resident_count" property="residentCount" />
    </resultMap>

    <!--status 为动态计算值：维修(3)保持手动设置不变，其余按入住人数计算；外层子查询过滤，避免 HAVING 非聚合条件-->
    <select id="list" resultMap="RoomVOMap">
        SELECT * FROM (
            SELECT r.id, r.building_id, r.room_no, r.floor, r.room_type, r.bed_count,
                   r.create_time, r.update_time,
                   bu.building_name AS building_name,
                   COUNT(cir.id) AS resident_count,
                   CASE
                       WHEN r.status = 3 THEN 3
                       WHEN COUNT(cir.id) = 0 THEN 0
                       WHEN COUNT(cir.id) &gt;= IFNULL(r.bed_count, 0) THEN 2
                       ELSE 1
                   END AS status
            FROM room AS r LEFT JOIN building AS bu
            ON r.building_id = bu.id
            LEFT JOIN bed AS be
            ON r.id = be.room_id
            LEFT JOIN check_in_record AS cir
            ON be.id = cir.bed_id AND cir.status = 1
            GROUP BY r.id
        ) AS t
        <where>
            <if test="roomQuery.roomNo != null and roomQuery.roomNo != ''">
                AND t.room_no LIKE CONCAT('%', #{roomQuery.roomNo}, '%')
            </if>
            <if test="roomQuery.buildingId != null">
                AND t.building_id = #{roomQuery.buildingId}
            </if>
            <if test="roomQuery.roomType != null">
                AND t.room_type = #{roomQuery.roomType}
            </if>
            <if test="roomQuery.status != null">
                AND t.status = #{roomQuery.status}
            </if>
        </where>
    </select>
</mapper>
