<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.situ.elder.mapper.BedMapper">
    <resultMap id="BedVOMap" type="com.situ.elder.pojo.vo.BedVO">
        <id column="id" property="id" />
        <result column="room_id" property="roomId" />
        <result column="bed_no" property="bedNo" />
        <result column="room_no" property="roomNo" />
        <result column="building_name" property="buildingName" />
        <result column="status" property="status" />
        <result column="price" property="price" />
        <result column="elder_name" property="elderName" />
        <result column="elder_phone" property="elderPhone" />
        <result column="elder_id_card_no" property="elderIdCardNo" />
        <result column="check_in_time" property="checkInTime" />
        <result column="update_time" property="updateTime" />
    </resultMap>

    <!--按房间查询床位：LEFT JOIN 房间表带出房间编号，LEFT JOIN 入住中(1)的入住记录带出入住老人信息-->
    <select id="listByRoom" resultMap="BedVOMap">
        SELECT be.*, r.room_no AS room_no, b.building_name AS building_name,
               e.name AS elder_name, e.phone AS elder_phone, e.id_card_no AS elder_id_card_no,
               cir.check_in_time AS check_in_time
        FROM bed AS be
        LEFT JOIN room AS r
        ON be.room_id = r.id
        LEFT JOIN building AS b
        ON r.building_id = b.id
        LEFT JOIN check_in_record AS cir
        ON be.id = cir.bed_id AND cir.status = 1
        LEFT JOIN elder AS e
        ON cir.elder_id = e.id
        WHERE be.room_id = #{roomId}
        ORDER BY be.bed_no
    </select>
</mapper>
